{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "cacheDir": ".cache/turbo",
  "tasks": {
    "build": {
      "outputs": ["dist/**/*"]
    },
    "types": {},
    "check:deps": {},
    "test": {
      "dependsOn": ["^test"]
    },
    "e2e": {
      "dependsOn": ["e2e:generate", "e2e:types"]
    },
    "e2e:generate": {
      "cache": false
    },
    "e2e:types": {
      "dependsOn": ["e2e:generate"]
    }
  }
}
