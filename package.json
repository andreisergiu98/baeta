{
  "name": "baeta",
  "private": true,
  "keywords": [
    "baeta",
    "graphql",
    "schema",
    "types",
    "typescript",
    "framework",
    "builder"
  ],
  "homepage": "https://github.com/andreisergiu98/baeta#readme",
  "bugs": {
    "url": "https://github.com/andreisergiu98/baeta/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andreisergiu98/baeta.git",
    "directory": "."
  },
  "license": "MIT",
  "author": {
    "name": "Andrei Pampu",
    "url": "https://github.com/andreisergiu98"
  },
  "type": "module",
  "workspaces": [
    "website",
    "packages/*",
    "tests/*",
    "tools/*",
    "examples/*",
    "packages/create-baeta/meta/*"
  ],
  "scripts": {
    "build": "turbo build --filter='./packages/*'",
    "check:circular": "turbo test:circular --filter='./packages/*'",
    "check:constraints": "yarn constraints",
    "check:formatting": "prettier --check . && sort-package-json **/package.json --check",
    "check:linting": "biome check .",
    "check:tests": "turbo test --filter='./packages/*'",
    "check:types": "turbo types",
    "docs:api": "yarn workspace @baeta/website write-api",
    "docs:build": "yarn workspace @baeta/website build",
    "docs:dev": "yarn workspace @baeta/website start",
    "examples:build": "yarn workspaces foreach -Wp --from '@baeta/examples*' run build",
    "examples:sync": "./examples/sync.sh",
    "examples:types": "yarn workspaces foreach -Wp --from '@baeta/examples*' run tsc --noEmit",
    "precommit": "lint-staged -c .lintstagedrc.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@baeta/builder": "workspace:^",
    "@biomejs/biome": "^2.4.6",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@types/node": "catalog:dev",
    "@yarnpkg/sdks": "^3.2.3",
    "@yarnpkg/types": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "sort-package-json": "^3.6.1",
    "turbo": "^2.8.13",
    "typescript": "catalog:dev"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
