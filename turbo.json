{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "cacheDir": ".cache/turbo",
  "concurrency": "10",
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "outputs": ["dist/**/*"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "types": {
      "dependsOn": ["^types"]
    },
    "check:deps": {},
    "e2e": {
      "dependsOn": ["e2e:generate:operations", "e2e:types"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "base/**"]
    },
    "e2e:types": {
      "dependsOn": ["^types", "e2e:generate:operations"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "base/**"]
    },
    "e2e:generate:baeta": {
      "cache": false
    },
    "e2e:generate:operations": {
      "dependsOn": ["e2e:generate:baeta"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "base/**", "!src/__generated__/gql/**"],
      "outputs": ["src/__generated__/gql/**/*"]
    }
  }
}
