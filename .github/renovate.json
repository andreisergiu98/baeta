{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "abandonments:recommended",
    ":configMigration"
  ],
  "timezone": "Europe/Bucharest",
  "schedule": [
    "after 12pm"
  ],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 25,
  "postUpdateOptions": [
    "yarnDedupeHighest"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "after 12pm on monday"
    ],
    "minimumReleaseAge": "3 days"
  },
  "ignorePaths": [],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dependencies"
    },
    {
      "matchDepTypes": [
        "dependencies",
        "devDependencies"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchDepTypes": [
        "peerDependencies"
      ],
      "rangeStrategy": "replace"
    },
    {
      "matchPackageNames": [
        "node",
        "actions/node-versions"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "redis"
      ],
      "allowedVersions": "<8"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "valkey/valkey"
      ],
      "allowedVersions": "<9"
    }
  ]
}
