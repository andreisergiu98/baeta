{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "outputs": [
        "dist/**/*"
      ]
    },
    "check:deps": {},
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "test:circular": {},
    "types": {},
    "e2e": {
      "dependsOn": [
        "e2e:generate",
        "e2e:types"
      ]
    },
    "e2e:generate": {
      "cache": false
    },
    "e2e:types": {
      "dependsOn": [
        "e2e:generate"
      ]
    }
  }
}
