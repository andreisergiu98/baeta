
# Tell git to guess whether files are text or binary.
# Force git to use LF
* text=auto eol=lf

# Override language detection for .json files to be JSON5
/.vscode/*.json         linguist-language=JSON5

# Generated by Baeta
examples/**/__generated__/ linguist-generated
examples/**/modules/*/typedef.ts linguist-generated
examples/**/modules/index.ts linguist-generated

# Hide .yarn and docs from language detection
.yarn linguist-vendored
website/** linguist-documentation
packages/*/CHANGELOG.md linguist-documentation