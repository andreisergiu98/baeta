{
  "name": "create-baeta",
  "version": "2.0.0-next.17",
  "description": "Scaffold new Baeta projects.",
  "keywords": [
    "baeta",
    "builder",
    "framework",
    "graphql",
    "schema",
    "types",
    "typescript"
  ],
  "homepage": "https://github.com/andreisergiu98/baeta#readme",
  "bugs": {
    "url": "https://github.com/andreisergiu98/baeta/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Andrei Pampu",
    "url": "https://github.com/andreisergiu98"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreisergiu98/baeta.git",
    "directory": "packages/create-baeta"
  },
  "bin": "dist/cli.js",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "yarn prebuild && builder build",
    "check:deps": "builder check-deps",
    "postpack": "builder prepare --restore",
    "prebuild": "yarn write:apollo:versions && yarn write:yoga:versions",
    "prepack": "builder prepare",
    "test": "builder test",
    "types": "yarn prebuild && tsc --noEmit",
    "write:apollo:versions": "builder write-versions-manifest ./meta/apollo/package.json -o versions.apollo.json",
    "write:yoga:versions": "builder write-versions-manifest ./meta/yoga/package.json -o versions.yoga.json"
  },
  "dependencies": {
    "@inquirer/input": "^5.1.2",
    "@inquirer/select": "^5.2.1",
    "execa": "^9.6.1",
    "log-symbols": "^7.0.1",
    "semver": "^7.8.5",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@baeta/builder": "workspace:^",
    "@baeta/testing": "workspace:^",
    "@baeta/tsconfig": "workspace:^",
    "@types/node": "catalog:dev",
    "@types/semver": "^7.8.0",
    "@types/yargs": "^17.0.35",
    "typescript": "catalog:dev"
  },
  "ava": {
    "extensions": [
      "ts"
    ]
  },
  "engines": {
    "node": "^22.20.0 || ^24.0.0 || >=26.0.0"
  },
  "typedocOptions": {
    "entryPoints": [
      "./index.ts"
    ],
    "readme": "none",
    "tsconfig": "./tsconfig.json",
    "sort": [
      "kind",
      "instance-first",
      "required-first",
      "alphabetical-ignoring-documents"
    ]
  }
}
