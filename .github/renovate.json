{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "abandonments:recommended",
    ":configMigration"
  ],
  "timezone": "Europe/Bucharest",
  "schedule": ["after 12pm"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 25,
  "postUpdateOptions": ["yarnDedupeHighest"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["after 12pm on monday"],
    "minimumReleaseAge": "3 days"
  },
  "ignorePaths": [],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies"
    },
    {
      "matchDepTypes": ["dependencies", "devDependencies"],
      "rangeStrategy": "bump"
    },
    {
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "replace"
    },
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<23"
    },
    {
      "matchPackageNames": ["node", "actions/node-versions"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["redis"],
      "allowedVersions": "<8"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["valkey/valkey"],
      "allowedVersions": "<9"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".github/workflows-src/_shared/actions.ts"],
      "groupName": "github actions",
      "postUpgradeTasks": {
        "commands": ["yarn install --immutable", "yarn actions:build"],
        "fileFilters": [".github/workflows/**", ".github/workflows-src/_shared/actions.ts"],
        "executionMode": "branch"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "github-actions-pinned",
      "managerFilePatterns": ["/^\\.github/workflows-src/_shared/actions\\.ts$/"],
      "matchStrings": [
        "['\"](?<depName>[^'\"@\\s]+)@(?<currentDigest>[a-f0-9]{40})['\"],\\s*//\\s*(?<currentValue>[Vv]?\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "depTypeTemplate": "action"
    }
  ],
  "dependencyDashboardFooter": "\n- [ ] <!-- manual job -->Check this box to trigger a request for Renovate to run again on this repository\n"
}
