{
  "name": "baeta",
  "private": true,
  "keywords": [
    "baeta",
    "builder",
    "framework",
    "graphql",
    "schema",
    "types",
    "typescript"
  ],
  "homepage": "https://github.com/andreisergiu98/baeta#readme",
  "bugs": {
    "url": "https://github.com/andreisergiu98/baeta/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Andrei Pampu",
    "url": "https://github.com/andreisergiu98"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreisergiu98/baeta.git"
  },
  "workspaces": [
    "config",
    "website",
    "packages/*",
    "tests/*",
    "tools/*",
    "examples/*",
    "packages/create-baeta/meta/*",
    "e2e/*"
  ],
  "type": "module",
  "scripts": {
    "actions:build": "github-actions-workflow-builder --cleanup --directory .github/workflows-src",
    "actions:check": "github-actions-workflow-builder --cleanup --check --directory .github/workflows-src",
    "build": "turbo build --filter='./packages/*'",
    "check:constraints": "yarn constraints",
    "check:deps": "turbo check:deps --filter='./packages/*'",
    "check:e2e": "yarn check:e2e:setup && turbo e2e --filter='./e2e/*'",
    "check:e2e:setup": "git clean -fdX ./e2e >/dev/null && turbo gen e2e",
    "check:formatting": "oxfmt --check",
    "check:linting": "eslint --flag unstable_native_nodejs_ts_config --cache --cache-location .cache/eslint .",
    "check:tests": "turbo test --filter='./packages/*'",
    "check:types": "turbo types --filter='./packages/*' && yarn tsc --noEmit",
    "docs:build": "yarn workspace @baeta/website build",
    "docs:dev": "yarn workspace @baeta/website start",
    "docs:generate": "yarn workspace @baeta/website write-api",
    "examples:build": "yarn workspaces foreach -Wp --from '@baeta/examples*' run build",
    "examples:sync": "turbo gen examples && yarn examples:build",
    "examples:types": "yarn workspaces foreach -Wp --from '@baeta/examples*' run types",
    "precommit": "lint-staged -c .lintstagedrc.js && yarn actions:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@baeta/builder": "workspace:^",
    "@baeta/changelog": "workspace:^",
    "@baeta/tsconfig": "workspace:^",
    "@baeta/workspace-config": "workspace:^",
    "@changesets/cli": "^2.31.0",
    "@eslint-react/eslint-plugin": "^5.7.5",
    "@eslint/css": "^1.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:dev",
    "@typescript-eslint/parser": "^8.59.2",
    "@yarnpkg/sdks": "^3.2.3",
    "@yarnpkg/types": "^4.0.1",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-package-json": "^0.91.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "github-actions-workflow-builder": "^4.1.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.1.0",
    "lint-staged": "^17.0.3",
    "lockfile-lint": "^5.0.0",
    "oxfmt": "^0.48.0",
    "turbo": "^2.9.12",
    "typescript": "catalog:dev",
    "typescript-eslint": "^8.59.2"
  },
  "dependenciesMeta": {
    "@apollo/rover@0.38.1": {
      "unplugged": true
    }
  },
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42"
}
