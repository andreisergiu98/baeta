{
  "search.exclude": {
    "**/.docusaurus": true,
    "**/.pnp.*": true,
    "**/.turbo": true,
    "**/.yarn": true,
    "**/dist": true,
    "packages/*/coverage": true,
    "website/build": true
  },
  "files.exclude": {
    "**/.docusaurus": true,
    "**/.pnp.*": true,
    "**/.turbo": true,
    "**/node_modules": true,
    "packages/*/coverage": true,
    "website/build": true,
    "website/.yarn": true
  },
  "cSpell.words": [
    "autoload",
    "autoloading",
    "baeta",
    "bodyparser",
    "callsite",
    "camelcase",
    "centrifugo",
    "clsx",
    "codegen",
    "cooldown",
    "datamodel",
    "dirpath",
    "evalsha",
    "execa",
    "grapgqlrc",
    "iovalkey",
    "middlewares",
    "outdir",
    "pexpireat",
    "tokenless",
    "unnormalized",
    "upstash",
    "valkey",
    "zadd",
    "zremrangebyscore"
  ],
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.preferences.importModuleSpecifierEnding": "js",
  "js/ts.tsdk.path": ".yarn/sdks/typescript/lib",
  "eslint.nodePath": ".yarn/sdks",
  "eslint.options": {
    "flags": ["unstable_native_nodejs_ts_config"]
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[graphql]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[mdx]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
