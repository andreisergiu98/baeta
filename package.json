{
  "name": "baeta",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "baeta",
    "builder",
    "framework",
    "graphql",
    "schema",
    "types",
    "typescript"
  ],
  "homepage": "https://github.com/andreisergiu98/baeta#readme",
  "bugs": {
    "url": "https://github.com/andreisergiu98/baeta/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Andrei Pampu",
    "url": "https://github.com/andreisergiu98"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreisergiu98/baeta.git"
  },
  "workspaces": [
    "config",
    "website",
    "packages/*",
    "tests/*",
    "tools/*",
    "examples/*",
    "packages/create-baeta/meta/*",
    "e2e/*"
  ],
  "type": "module",
  "scripts": {
    "actions:build": "github-actions-workflow-builder --cleanup --directory .github/workflows-src",
    "actions:check": "github-actions-workflow-builder --cleanup --check --directory .github/workflows-src",
    "build": "turbo build --filter='!./examples/*' --filter='!./website'",
    "check:constraints": "yarn constraints",
    "check:deps": "turbo check:deps",
    "check:e2e": "yarn check:e2e:setup && yarn check:e2e:run",
    "check:e2e:run": "turbo e2e --filter='./e2e/*' --filter='./packages/*'",
    "check:e2e:setup": "git clean -fdX ./e2e >/dev/null && builder generate ./e2e/_shared/generate-rules.ts",
    "check:formatting": "oxfmt --check",
    "check:linting": "eslint --flag unstable_native_nodejs_ts_config --cache --cache-location .cache/eslint .",
    "check:tests": "turbo test",
    "check:types": "turbo types --filter='!./examples/*' && yarn tsc --noEmit",
    "docs:build": "yarn workspace @baeta/website build",
    "docs:dev": "yarn workspace @baeta/website start",
    "docs:generate": "yarn workspace @baeta/website write-api",
    "examples:build": "yarn workspaces foreach -Wp --from '@baeta/examples*' run build",
    "examples:sync": "builder generate ./examples/_shared/generate-rules.ts && yarn examples:build",
    "examples:types": "yarn workspaces foreach -Wp --from '@baeta/examples*' run types",
    "precommit": "lint-staged -c .lintstagedrc.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@baeta/builder": "workspace:^",
    "@baeta/changelog": "workspace:^",
    "@baeta/tsconfig": "workspace:^",
    "@baeta/workspace-config": "workspace:^",
    "@changesets/cli": "^2.31.1",
    "@eslint-react/eslint-plugin": "^5.18.7",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:dev",
    "@typescript-eslint/parser": "^8.69.0",
    "@yarnpkg/sdks": "^3.3.1",
    "@yarnpkg/types": "^4.0.1",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-package-json": "^1.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "github-actions-workflow-builder": "^4.1.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^17.4.1",
    "lockfile-lint": "^5.0.1",
    "oxfmt": "^0.66.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:dev",
    "typescript-eslint": "^8.69.0"
  },
  "dependenciesMeta": {
    "@apollo/rover@0.41.0": {
      "unplugged": true
    }
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}
