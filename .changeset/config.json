{
  "$schema": "https://unpkg.com/@changesets/config@3.1.2/schema.json",
  "changelog": [
    "@baeta/changelog",
    {
      "repo": "andreisergiu98/baeta"
    }
  ],
  "commit": false,
  "access": "public",
  "baseBranch": "next",
  "updateInternalDependencies": "patch",
  "snapshot": {
    "useCalculatedVersion": false,
    "prereleaseTemplate": "{tag}-{datetime}-{commit}"
  },
  "fixed": [
    [
      "create-baeta",
      "@baeta/auth",
      "@baeta/cache",
      "@baeta/cache-cloudflare",
      "@baeta/cache-ioredis",
      "@baeta/cache-iovalkey",
      "@baeta/cache-upstash",
      "@baeta/cli",
      "@baeta/complexity",
      "@baeta/core",
      "@baeta/directives",
      "@baeta/env",
      "@baeta/errors",
      "@baeta/federation",
      "@baeta/plugin-cloudflare",
      "@baeta/plugin-directives",
      "@baeta/plugin-exec",
      "@baeta/plugin-federation",
      "@baeta/plugin-gitignore",
      "@baeta/plugin-graphql",
      "@baeta/plugin-pagination",
      "@baeta/plugin-prisma",
      "@baeta/subscriptions-pubsub"
    ]
  ],
  "privatePackages": {
    "version": false,
    "tag": false
  },
  "ignore": []
}
